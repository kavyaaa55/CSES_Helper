generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Solution {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  problemId    Int
  username     String
  solutionLink String
  createdAt    DateTime @default(now())

  @@unique([problemId, username])
}
